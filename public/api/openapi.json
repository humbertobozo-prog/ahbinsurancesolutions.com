{
  "openapi": "3.1.0",
  "info": {
    "title": "AHB Insurance Solutions API",
    "description": "Public APIs for AHB Insurance Solutions - Independent Florida Insurance Brokerage led by Andres H. Bozo (NPN: 21228432).",
    "version": "1.0.0",
    "contact": {
      "name": "Andres H. Bozo",
      "email": "andreshbozo@ahbinsurancesolutions.com",
      "url": "https://www.ahbinsurancesolutions.com"
    }
  },
  "servers": [
    {
      "url": "https://www.ahbinsurancesolutions.com",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns operational status and timestamp of the AHB Insurance Solutions backend.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "summary": "Submit Insurance Lead / Consultation Request",
        "description": "Allows clients and authorized agents to submit consultation inquiries for Medicare, Final Expense, or IUL insurance in Florida.",
        "operationId": "submitContactLead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "phone"],
                "properties": {
                  "name": { "type": "string", "example": "Jane Doe" },
                  "email": { "type": "string", "format": "email", "example": "jane@example.com" },
                  "phone": { "type": "string", "example": "352-555-0199" },
                  "zipCode": { "type": "string", "example": "32608" },
                  "birthYear": { "type": "string", "example": "1959" },
                  "region": { "type": "string", "example": "North Central Florida" },
                  "age": { "type": "string", "example": "65" },
                  "eligibility": { "type": "string", "example": "Medicare Supplement Plan G" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lead recorded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
